---
layout: null
sitemap: false
---
{
  "name": {{ site.brand_name | jsonify }},
  "short_name": {{ site.brand_name | jsonify }},
  "start_url": "/",
  "display": "standalone",
  "background_color": "#F7F6F2",
  "theme_color": "#172B3A",
  "icons": [
    {% if site.brand.icon_192 != "" %}{ "src": {{ site.brand.icon_192 | jsonify }}, "sizes": "192x192", "type": "image/png" }{% endif %}{% if site.brand.icon_512 != "" %},
    { "src": {{ site.brand.icon_512 | jsonify }}, "sizes": "512x512", "type": "image/png" }{% endif %}
  ]
}
